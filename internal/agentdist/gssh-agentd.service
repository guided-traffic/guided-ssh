[Unit]
Description=guided-ssh Host Agent (certificate renewal, principals cache)
Documentation=https://github.com/guided-traffic/guided-ssh
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/gssh-agentd run
Restart=on-failure
RestartSec=5s
# Enrollment (gssh-agentd enroll --token …) must have run before the first start.
# State: /var/lib/guided-ssh (mTLS material, configuration, principals cache)
ProtectSystem=full
ReadWritePaths=/var/lib/guided-ssh /etc/ssh
NoNewPrivileges=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
