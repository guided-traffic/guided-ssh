#!/bin/sh
# guided-ssh One-Command-Host-Install — vom Server getemplatet (Version {{.Version}}).
#
#   curl -fsSL {{.BaseURL}}/install.sh | sudo sh -s -- --token gssh-et-…
#
# Server-URL, Agent-URL, SPKI-Pin, Binary-Hashes und die systemd-Unit stecken
# bereits in diesem Script; variabel sind nur Token und Flags.
#
# POSIX-sh, bewusst ohne pipefail (in dash/busybox nicht verlässlich) — Fehler
# in Pipes werden über Exit-Codes geprüft.
# Das gesamte Script steckt in main(); der Aufruf steht in der letzten Zeile,
# damit eine abgebrochene Übertragung kein halbes Script ausführt.
set -eu

SERVER_URL='{{.BaseURL}}'
AGENT_URL='{{.AgentURL}}'
PIN='{{.Pin}}'
VERSION='{{.Version}}'
ARCHES='{{.ArchList}}'

BIN=/usr/bin/gssh-agentd
UNIT=/etc/systemd/system/gssh-agentd.service
STATE=/var/lib/guided-ssh
SOCKET="$STATE/agentd.sock"

# tmp hält das heruntergeladene Binary bis zum atomaren mv; der EXIT-Trap räumt
# es weg, falls das Script vorher abbricht.
tmp=''

fail() {
    echo "gssh-install: fehler: $*" >&2
    exit 1
}

cleanup() {
    if [ -n "$tmp" ]; then
        rm -f "$tmp"
    fi
}

usage() {
    cat >&2 <<'USAGE_EOF'
aufruf: install.sh --token <enrollment-token> [--arch amd64|arm64]
                   [--session-audit] [--no-systemd]

  --token          einmaliges Enrollment-Token (Pflicht)
  --arch           Ziel-Architektur; ohne Angabe aus `uname -m`
  --session-audit  Host-Session-/sudo-Audit aktivieren (pam_exec, opt-in)
  --no-systemd     Unit nur schreiben, nicht aktivieren (Hosts ohne systemd)
USAGE_EOF
}

# arch_from_uname bildet `uname -m` auf die Namen der Agent-Binaries ab; leere
# Ausgabe heißt „nicht unterstützt".
arch_from_uname() {
    case "$(uname -m)" in
        x86_64) echo amd64 ;;
        aarch64) echo arm64 ;;
        *) echo '' ;;
    esac
}

# sha_for_arch liefert den erwarteten SHA-256 (Hex) des Binaries; leer, wenn für
# die Architektur keines eingebettet ist.
sha_for_arch() {
    case "$1" in
{{- range .Agents}}
        {{.Arch}}) echo '{{.SHA256}}' ;;
{{- end}}
        *) echo '' ;;
    esac
}

# wait_ready wartet bis zu 10 s auf einen wirklich bereiten Daemon: aktive Unit
# *und* vorhandener Socket. Bei Type=simple sagt `is-active` allein nur, dass
# der Prozess gestartet wurde; den Socket legt der Agent erst bei Bereitschaft an.
wait_ready() {
    i=0
    while [ "$i" -lt 10 ]; do
        if systemctl is-active --quiet gssh-agentd && [ -S "$SOCKET" ]; then
            return 0
        fi
        sleep 1
        i=$((i + 1))
    done
    return 1
}

main() {
    token=''
    arch=''
    session_audit=0
    use_systemd=1
    reused_enrollment=0

    while [ $# -gt 0 ]; do
        case "$1" in
            --token) [ $# -ge 2 ] || fail "--token braucht einen wert"; token="$2"; shift 2 ;;
            --token=*) token="${1#--token=}"; shift ;;
            --arch) [ $# -ge 2 ] || fail "--arch braucht einen wert"; arch="$2"; shift 2 ;;
            --arch=*) arch="${1#--arch=}"; shift ;;
            --session-audit) session_audit=1; shift ;;
            --no-systemd) use_systemd=0; shift ;;
            -h|--help) usage; return 0 ;;
            *) usage; fail "unbekanntes argument: $1" ;;
        esac
    done
    [ -n "$token" ] || { usage; fail "--token fehlt"; }

    trap cleanup EXIT

    # 1. Vorbedingungen
    [ "$(id -u)" = 0 ] || fail "bitte als root ausführen (sudo sh -s -- …)"
    command -v curl >/dev/null 2>&1 || fail "curl fehlt — bitte installieren"
    command -v sshd >/dev/null 2>&1 || fail "sshd fehlt — bitte openssh-server installieren"
    if [ ! -f /etc/ssh/ssh_host_ed25519_key.pub ]; then
        echo "gssh-install: erzeuge fehlende ssh-host-keys (ssh-keygen -A)"
        ssh-keygen -A || fail "ssh-keygen -A fehlgeschlagen"
    fi

    # 2. Pin-Guard — doppelter Boden. Das Server-Gate liefert dieses Script gar
    #    nicht erst ohne Pin aus; ungepinnt enrollt wird trotzdem nie.
    [ -n "$PIN" ] || fail "kein spki-pin im script — server-rollout nicht konfiguriert"

    # 3. Architektur bestimmen
    if [ -z "$arch" ]; then
        arch="$(arch_from_uname)"
        [ -n "$arch" ] || fail "architektur $(uname -m) nicht unterstützt — verfügbar: $ARCHES (ggf. --arch setzen)"
    fi
    sha="$(sha_for_arch "$arch")"
    [ -n "$sha" ] || fail "kein agent-binary für arch '$arch' — verfügbar: $ARCHES"

    # 4. Binary laden und atomar tauschen. Das Tempfile liegt im Zielverzeichnis
    #    (gleiche Partition), sonst wäre das mv ein nicht-atomarer Cross-Device-
    #    Copy. Kein `systemctl stop` davor: rename(2) ersetzt auch das Binary
    #    eines laufenden Daemons ohne ETXTBSY, der behält sein altes Inode.
    echo "gssh-install: lade gssh-agentd $VERSION (linux/$arch)"
    tmp="$(mktemp /usr/bin/.gssh-agentd.XXXXXX)" || fail "tempfile in /usr/bin anlegen fehlgeschlagen"
    curl -fsSL "$SERVER_URL/v1/agents/linux/$arch" -o "$tmp" || fail "download von $SERVER_URL/v1/agents/linux/$arch fehlgeschlagen"
    echo "$sha  $tmp" | sha256sum -c - >/dev/null 2>&1 || fail "sha256-prüfung fehlgeschlagen — binary verworfen"
    chmod 0755 "$tmp"
    mv -f "$tmp" "$BIN" || fail "$BIN ersetzen fehlgeschlagen"
    tmp=''

    # 5. State-Verzeichnis (mTLS-Material, Konfiguration, Principals-Cache)
    mkdir -p "$STATE"
    chmod 700 "$STATE"

    # 6. systemd-Unit. Bewusst /etc/systemd/system (nicht /lib — das gehört den
    #    Paketen); Script- und deb/rpm-Install nicht mischen.
    cat >"$UNIT" <<'UNIT_EOF'
{{.Unit}}UNIT_EOF

    # 7. Enrollment — läuft immer, auch auf einem bereits enrollten Host. Ein
    #    Re-Run derselben Zeile scheitert hier (Token einmalig verbraucht); mit
    #    vorhandener config.yaml wird deshalb degradiert weitergemacht statt
    #    abzubrechen, ohne sie ist der Abbruch hart.
    set -- enroll --server "$SERVER_URL" --agent-url "$AGENT_URL" \
        --token "$token" --pin "$PIN" --require-pin
    if [ "$session_audit" = 1 ]; then
        set -- "$@" --session-audit
    fi
    if "$BIN" "$@"; then
        echo "gssh-install: enrollment erfolgreich"
    elif [ -f "$STATE/config.yaml" ]; then
        reused_enrollment=1
        echo "gssh-install: WARNUNG: enrollment fehlgeschlagen — bestehendes enrollment aus $STATE/config.yaml wird weiterverwendet." >&2
    else
        fail "enrollment fehlgeschlagen und kein bestehendes $STATE/config.yaml — host nicht einsatzbereit"
    fi

    # 8. Dienst starten
    if [ "$use_systemd" = 0 ]; then
        echo "gssh-install: --no-systemd — übersprungen: daemon-reload, enable/start, health-check"
        echo "gssh-install: manuell aktivieren: systemctl daemon-reload && systemctl enable --now gssh-agentd"
    else
        command -v systemctl >/dev/null 2>&1 || fail "systemctl nicht gefunden — mit --no-systemd erneut ausführen"
        systemctl daemon-reload
        # `enable --now` startet eine bereits aktive Unit *nicht* neu — beim
        # Upgrade liefe sonst weiter das alte Binary.
        if systemctl is-active --quiet gssh-agentd; then
            systemctl restart gssh-agentd
        else
            systemctl enable --now gssh-agentd
        fi
        # 9. Health-Check
        wait_ready || fail "gssh-agentd wurde nicht bereit — diagnose: journalctl -u gssh-agentd -n 20"
        echo "gssh-install: dienst aktiv, socket $SOCKET vorhanden"
    fi

    # 10. Abschluss
    echo "gssh-install: fertig — gssh-agentd $VERSION unter $BIN installiert"
    if [ "$reused_enrollment" = 1 ]; then
        echo "gssh-install: WARNUNG: das übergebene token wurde NICHT eingelöst; der host läuft mit seinem bisherigen enrollment weiter." >&2
    fi
}

main "$@"
