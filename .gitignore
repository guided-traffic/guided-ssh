# Build artifacts
/bin/
coverage.out
/coverage/

# Web UI (Phase 8): build output is embedded into the Go binary; only the
# .gitkeep placeholder is versioned, so go:embed builds without a Node build.
web/node_modules/
web/dist/*
!web/dist/.gitkeep
web/.angular/

# Agent and client binaries for the one-command installs: produced by the
# Docker build (or locally via `make cross`) and embedded via go:embed —
# never commit them.
internal/agentdist/bin/*
!internal/agentdist/bin/.gitkeep
internal/clientdist/bin/*
!internal/clientdist/bin/.gitkeep

# Helm: downloaded subchart archives (Chart.lock stays versioned)
deploy/helm/guided-ssh/charts/

# Tooling outputs
graphify-out/cost.json
graphify-out/.graphify_python
graphify-out/cache/

# OS
.DS_Store
